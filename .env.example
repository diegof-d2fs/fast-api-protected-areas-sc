PA_SC_ENVIRONMENT=development
PA_SC_LOG_LEVEL=INFO
PA_SC_DATA_ROOT=/app/data

PA_SC_MAX_UPLOAD_BYTES=52428800
PA_SC_UPLOAD_CHUNK_BYTES=1048576
PA_SC_MAX_ZIP_ENTRIES=64
PA_SC_MAX_ZIP_UNCOMPRESSED_BYTES=262144000
PA_SC_MAX_ZIP_COMPRESSION_RATIO=100
PA_SC_MAX_FEATURES=10000
PA_SC_MAX_VERTICES=1000000
PA_SC_MAX_REPAIR_AREA_DELTA_RATIO=0.01

PA_SC_CANONICAL_EPSG=4674
PA_SC_METRIC_EPSG=31982
PA_SC_SC_BBOX_MIN_X=-54.5
PA_SC_SC_BBOX_MIN_Y=-29.8
PA_SC_SC_BBOX_MAX_X=-47.8
PA_SC_SC_BBOX_MAX_Y=-25.5
PA_SC_TERRITORIAL_RULE=intersects_bbox

PA_SC_READINESS_REQUIRES_POSTGIS=false
PA_SC_READINESS_REQUIRES_AIRFLOW=false
PA_SC_DATABASE_DSN=postgresql://project:project@protected-areas-sc-db-main:5432/protected-areas-sc-db-main

# Bootstrap do primeiro administrador (só usado quando app_user está vazia). Não versionar
# valores reais aqui; definir localmente ou no orquestrador de segredos do ambiente.
PA_SC_ADMIN_BOOTSTRAP_USERNAME=
PA_SC_ADMIN_BOOTSTRAP_PASSWORD=
PA_SC_SESSION_TTL_HOURS=12
PA_SC_LOGIN_LOCKOUT_THRESHOLD=5
PA_SC_LOGIN_LOCKOUT_WINDOW_MINUTES=15
# true em produção (exige HTTPS real para o cookie de sessão funcionar); só usar false para
# testar o login manualmente via Postman/curl sem TLS local. Um navegador real aceita `Secure`
# tanto em https:// quanto em http://localhost, então a demonstração pelo navegador não precisa
# disso mesmo com true.
PA_SC_SESSION_COOKIE_SECURE=true

# Integração local com a stack Airflow
PIPELINE_DATA_DIR=F:/Univali/2025_2/TCC/git/pipeline-protected-areas-sc/airflow/data
PA_SC_BRONZE_ROOT=/pipeline-data/bronze
PA_SC_AIRFLOW_BASE_URL=http://protected-areas-sc-airflow-webserver:8080
PA_SC_AIRFLOW_USERNAME=admin
PA_SC_AIRFLOW_PASSWORD=admin
PA_SC_AIRFLOW_TIMEOUT_SECONDS=10

# Camada reporting: senhas dos logins somente leitura (aplicadas por api-migrate)
PA_SC_REPORTING_GEOSERVER_DB_PASSWORD=
PA_SC_REPORTING_POWERBI_DB_PASSWORD=
